# Optional: Gemini API key for LLM-generated operations brief.
# Without this set, Voltex falls back to a local template-based narrative.
GEMINI_API_KEY=

# Canonical public URL for Open Graph / Twitter previews (required on Vercel if previews show no image)
NEXT_PUBLIC_SITE_URL=https://voltex-eight.vercel.app

# Client API routing: dev = local Next server, prod = Railway backend
NEXT_PUBLIC_APP_ENV=dev
NEXT_PUBLIC_API_BASE_URL=https://gale-projecton-production.up.railway.app

# Optional overrides for local dev (defaults: localhost:3000)
# NEXT_PUBLIC_DEV_API_HOST=localhost
# NEXT_PUBLIC_DEV_API_PORT=3000

# Railway backend: extra CORS origins (voltex-eight.vercel.app + *.vercel.app are allowed by default)
# CORS_ALLOWED_ORIGINS=https://another-frontend.example.com
# CORS_ALLOW_VERCEL_PREVIEWS=false
